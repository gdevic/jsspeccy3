# HANGMAN: guess the word a letter at a time before the gallows are
# built. 60 words to find; a wrong letter adds a piece to the drawing,
# and ten wrong letters lose the game. A key is read with INKEY$, or from
# LAST_K (23560), where the ROM keeps the last key pressed, when it was let
# go before INKEY$ could see it.
10 REM HANGMAN
20 BORDER 6: PAPER 7: INK 0: CLS: RANDOMIZE
30 LET nw=60: LET wn=0: LET ls=0
100 REM a new word
110 RESTORE 900: FOR i=1 TO 1+INT (RND*nw): READ w$: NEXT i
120 DIM u$(26): LET e=0: LET f=0
130 CLS: PRINT AT 0,11; PAPER 6;" HANGMAN "
140 PRINT AT 2,0;"Won ";wn;"  Lost ";ls
150 PRINT AT 4,0;"Guess a letter."
160 GO SUB 300
200 REM a letter
210 PAUSE 0: LET k$=INKEY$: IF k$="" THEN LET k$=CHR$ PEEK 23560
215 IF k$>="a" AND k$<="z" THEN LET k$=CHR$ (CODE k$-32)
220 IF k$<"A" OR k$>"Z" THEN GO TO 210
230 LET c=CODE k$-64: IF u$(c)<>" " THEN PRINT AT 6,0;"You tried ";k$;"!": GO TO 210
240 LET u$(c)=k$: PRINT AT 6,0;"             ";AT 20,0;u$
250 LET h=0: FOR i=1 TO LEN w$: IF w$(i)=k$ THEN LET h=1
260 NEXT i
270 IF h THEN BEEP .05,12: GO SUB 300: IF f=LEN w$ THEN GO TO 400
280 IF NOT h THEN LET e=e+1: BEEP .2,-12: GO SUB 500+10*e: IF e=10 THEN GO TO 450
290 GO TO 210
300 REM the word, with the letters found so far
310 LET f=0: PRINT AT 18,0;
320 FOR i=1 TO LEN w$: IF u$(CODE w$(i)-64)<>" " THEN PRINT w$(i);" ";: LET f=f+1: GO TO 340
330 PRINT "_ ";
340 NEXT i: RETURN
400 REM won
410 LET wn=wn+1: PRINT AT 12,0; INK 4; FLASH 1;"You got it!": FOR i=0 TO 12 STEP 4: BEEP .1,i: NEXT i: GO TO 470
450 REM lost
460 LET ls=ls+1: PRINT AT 12,0; INK 2;"Hanged! It was";AT 13,0;w$: BEEP 1,-20
470 PRINT AT 21,0;"Press a key for another word.";
480 PAUSE 50: PAUSE 0: GO TO 100
500 REM the gallows, a piece for each wrong letter
510 PLOT 150,40: DRAW 90,0: RETURN
520 PLOT 170,40: DRAW 0,120: RETURN
530 PLOT 170,160: DRAW 50,0: RETURN
540 PLOT 170,140: DRAW 20,20: RETURN
550 PLOT 220,160: DRAW 0,-15: RETURN
560 CIRCLE 220,137,8: RETURN
570 PLOT 220,129: DRAW 0,-30: RETURN
580 PLOT 220,120: DRAW -12,-10: PLOT 220,120: DRAW 12,-10: RETURN
590 PLOT 220,99: DRAW -10,-18: RETURN
600 PLOT 220,99: DRAW 10,-18: RETURN
900 DATA "KITCHEN","SPECTRUM","KEYBOARD","PRINTER","CASSETTE","MICRODRIVE"
910 DATA "JOYSTICK","TELEVISION","COMPUTER","PROGRAM","ELEPHANT","GIRAFFE"
920 DATA "PENGUIN","DOLPHIN","KANGAROO","CROCODILE","BUTTERFLY","VOLCANO"
930 DATA "MOUNTAIN","RAINBOW","THUNDER","LIGHTNING","BLIZZARD","HURRICANE"
940 DATA "JUNGLE","DESERT","ISLAND","CASTLE","DRAGON","WIZARD"
950 DATA "PIRATE","TREASURE","ROCKET","PLANET","GALAXY","ASTRONAUT"
960 DATA "TELESCOPE","SUBMARINE","BICYCLE","HELICOPTER","SANDWICH","CHOCOLATE"
970 DATA "PANCAKE","SPAGHETTI","PINEAPPLE","STRAWBERRY","BANANA","AVOCADO"
980 DATA "UMBRELLA","PYJAMAS","BLANKET","PILLOW","CUPBOARD","WARDROBE"
