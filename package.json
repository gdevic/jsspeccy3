{
  "name": "jsspeccy",
  "version": "3.2.3",
  "description": "a ZX Spectrum emulator in the browser",
  "main": "jsspeccy.js",
  "type": "module",
  "scripts": {
    "test": "npm run build && node test/test.js test/tests.in test/tests.expected",
    "build:core": "node generator/gencore.js generator/core.ts.in build/core.ts",
    "build:wasm:debug": "asc build/core.ts --target debug",
    "build:wasm:release": "asc build/core.ts --target release",
    "build:js": "node tools/build-js.js",
    "build:static": "node tools/copy-static.js",
    "build": "npm run build:core && npm run build:wasm:release && npm run build:js && npm run build:static",
    "build:debug": "npm run build:core && npm run build:wasm:debug && npm run build:js && npm run build:static",
    "watch": "node tools/watch.js"
  },
  "watch": {
    "build:core": {
      "patterns": [
        "generator/*.js",
        "generator/*.ts.in"
      ],
      "extensions": [
        "js",
        "in"
      ]
    },
    "build:wasm:release": {
      "patterns": [
        "build/core.ts"
      ],
      "extensions": "ts"
    },
    "build:js": {
      "patterns": [
        "runtime/*.js",
        "runtime/icons/*.svg",
        "build/*.js"
      ],
      "extensions": ["js", "svg"]
    },
    "build:static": {
      "patterns": [
        "static/*.html",
        "static/*.rom",
        "static/playzx/*"
      ],
      "extensions": [
        "html",
        "rom",
        "db"
      ]
    }
  },
  "author": "Matt Westcott",
  "license": "ISC",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "assemblyscript": "^0.19.6",
    "webpack": "^5.111.1"
  },
  "dependencies": {
    "file-dialog": "^0.0.8",
    "jszip": "^3.7.1",
    "pako": "^2.0.4",
    "sql.js": "^1.14.2"
  }
}
